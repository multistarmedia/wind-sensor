# Copy to .env and fill in. Placeholders only: the server refuses to start with them.

# Where Node listens. Keep it on localhost behind the reverse proxy.
HOST=127.0.0.1
PORT=3000

# Exact public origin users open (scheme + host, no path). http is allowed only for localhost.
PUBLIC_ORIGIN=https://weather.example.com

# Owner credential. Preferred: a hash from `npm run hash-password` (keep the single quotes).
OWNER_PASSWORD_HASH='replace-me'
# Alternative: a plain password of 12+ characters (hashed in memory at startup).
# OWNER_PASSWORD=

# Random secret, 32+ characters: openssl rand -hex 32
SESSION_SECRET=replace-me

# Persistent directory for the SQLite database and backups. Must survive deploys and restarts.
DATA_DIR=/var/lib/aio2-console

# Days of readings to keep (initial value; the owner can change it in Settings).
RETENTION_DAYS=90

# Express "trust proxy" setting: loopback when nginx runs on the same machine.
TRUST_PROXY=loopback
