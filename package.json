{
  "name": "aio2-weather-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live dashboard and logger for the Met One AIO 2 weather sensor, read through browser Web Serial.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts server/scripts/*.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist/server --out-extension:.js=.mjs",
    "start": "node dist/server/index.mjs",
    "migrate": "node dist/server/scripts/migrate.mjs",
    "backup": "node dist/server/scripts/backup.mjs",
    "restore": "node dist/server/scripts/restore.mjs",
    "hash-password": "node dist/server/scripts/hash-password.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@shopify/polaris": "13.9.5",
    "@shopify/polaris-icons": "9.3.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/supertest": "7.2.1",
    "@types/w3c-web-serial": "1.0.9",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
